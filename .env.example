# --- Base de datos ---
POSTGRES_USER=facturacion
POSTGRES_PASSWORD=facturacion_pass
POSTGRES_DB=facturacion_db

# Para nube (Railway/Render) reemplaza por el DATABASE_URL que te den:
DATABASE_URL=postgresql+psycopg2://facturacion:facturacion_pass@db:5432/facturacion_db

# --- Seguridad ---
SECRET_KEY=change_this_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Entorno ---
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# --- Negocio (parametrizable por cliente) ---
TASA_INTERES_MORA_MENSUAL=0.03
DIAS_MORA_PREVENTIVA=1
DIAS_MORA_ADMINISTRATIVA=30
DIAS_MORA_EXTRAJUDICIAL=90

# --- Reenganche ---
REENGANCHE_PORCENTAJE_MINIMO=0.5
REENGANCHE_DESCRIPCION_DEFECTO="Reenganche de crédito"
PRESTAMO_DESCRIPCION_DEFECTO="Préstamo personal"
